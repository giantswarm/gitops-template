#!/bin/bash
# shellcheck disable=SC2207,SC2016
set -euo pipefail

function help() {
	echo -e "
Check that the spec.path of every Flux Kustomization that applies this repository exists and
builds. Must be run from the repository root, or from the directory given as the only argument.

Usage: $0 [dir]

This repository's GitRepository is the sourceRef of the management cluster's own
Kustomization, the one whose spec.path is the directory its file is in, such as
management-clusters/MC_NAME/MC_NAME.yaml. Kustomizations with another source are left out,
and so are the ones in tools/testdata.

A path with a kustomization file is built with kustomize. A path without one is built the
way Flux builds it, from the YAML files and the directories with a kustomization file below
it, and must not be empty.
"
	exit 1
}

[ $# -gt 1 ] && help
cd "${1:-.}" || help

# kustomize if it's installed, otherwise the one built into kubectl
if command -v kustomize >/dev/null; then
	kustomize=(kustomize build --load-restrictor=LoadRestrictionsNone)
else
	kustomize=(kubectl kustomize --load-restrictor=LoadRestrictionsNone)
fi

tmp_dir=$(mktemp -d)
trap 'rm -rf "${tmp_dir}"' EXIT

##
# Whether directory $1 has a file kustomize builds it from.
function has_kustomization() {
	[ -e "$1/kustomization.yaml" ] || [ -e "$1/kustomization.yml" ] || [ -e "$1/Kustomization" ]
}

##
# What Flux applies from a directory without a kustomization file: its YAML files, and
# below it every directory with a kustomization file or, failing that, its YAML files.
function generated_resources() {
	if has_kustomization "$1"; then
		echo "$1"
		return
	fi
	find "$1" -maxdepth 1 -type f \( -name '*.yaml' -o -name '*.yml' \)
	for d in $(find "$1" -mindepth 1 -maxdepth 1 -type d | sort); do
		generated_resources "$d"
	done
}

##
# Build `path` of the Kustomization `name`; print what's wrong and fail if it doesn't build.
function check() {
	local name="$1" file="$2" path="${3#./}"
	path="${path:-.}"
	local dir="${tmp_dir}/build"

	if [ ! -d "${path}" ]; then
		echo "Kustomization ${name} in ${file}: spec.path '${path}' doesn't exist. Restore the directory," \
			"or delete the Kustomization: remove ${file} and its entry in the kustomization.yaml that lists it."
		return 1
	fi

	if has_kustomization "${path}"; then
		dir="${path}"
	else
		local resources=($(generated_resources "${path}"))
		if [ ${#resources[@]} -eq 0 ]; then
			echo "Kustomization ${name} in ${file}: spec.path '${path}' is empty. Delete the Kustomization:" \
				"remove ${file} and its entry in the kustomization.yaml that lists it."
			return 1
		fi
		rm -rf "${dir}"
		mkdir -p "${dir}"
		{
			echo "apiVersion: kustomize.config.k8s.io/v1beta1"
			echo "kind: Kustomization"
			echo "resources:"
			for r in "${resources[@]}"; do
				echo "  - $(realpath --relative-to="${dir}" "${r}")"
			done
		} >"${dir}/kustomization.yaml"
	fi

	local output
	if ! output=$("${kustomize[@]}" "${dir}" 2>&1 >/dev/null); then
		echo "Kustomization ${name} in ${file}: spec.path '${path}' doesn't build. A kustomization.yaml" \
			"lists something that's gone: remove its entry, or restore it. kustomize says:"
		echo "${output}" | sed 's/^/  /'
		return 1
	fi
}

# Every Flux Kustomization, one per line: file,namespace/name,path,source. v1beta2 is the API
#  version Flux 2.0 replaced with v1; Flux still reads Kustomizations written with it. One
#  without a namespace is applied in the default namespace.
files=($(find . \( -name '*.yaml' -o -name '*.yml' \) -not -path './tools/testdata/*' -not -path './.git/*' \
	-exec grep -l '^apiVersion: kustomize.toolkit.fluxcd.io/' {} + | sort || true))
if [ ${#files[@]} -eq 0 ]; then
	echo "No Flux Kustomization found below $(pwd): nothing to check."
	exit 1
fi
if ! kustomizations=$(yq --no-doc '
	select((.apiVersion == "kustomize.toolkit.fluxcd.io/v1" or .apiVersion == "kustomize.toolkit.fluxcd.io/v1beta2")
		and .kind == "Kustomization") |
	(.metadata.namespace // "default") as $ns |
	[filename, $ns + "/" + .metadata.name, .spec.path // "",
		.spec.sourceRef.kind + "/" + (.spec.sourceRef.namespace // $ns) + "/" + .spec.sourceRef.name] |
	join(",")' "${files[@]}"); then
	echo "yq couldn't read the Flux Kustomizations: nothing was checked."
	exit 1
fi

# this repository's GitRepository: the source of the Kustomizations that apply their own directory
sources=()
for k in ${kustomizations}; do
	IFS=, read -r file name path source <<<"${k}"
	path="${path#./}"
	path="${path%/}"
	if [ "$(dirname "${file#./}")" == "${path:-.}" ] && [[ "${source}" == GitRepository/* ]]; then
		sources+=("${source}")
	fi
done
if [ ${#sources[@]} -eq 0 ]; then
	echo "No Flux Kustomization applies the directory its file is in, as management-clusters/MC_NAME/MC_NAME.yaml" \
		"does: can't tell which GitRepository is this repository's, so nothing was checked."
	exit 1
fi

failed=0
for k in ${kustomizations}; do
	IFS=, read -r file name path source <<<"${k}"
	if [[ " ${sources[*]} " == *" ${source} "* ]]; then
		check "${name}" "${file#./}" "${path}" || failed=1
	fi
done
exit ${failed}
