#!/bin/bash
# shellcheck disable=SC2016
#
# Render the chart of every Flux HelmRelease in a manifest file with the values the
# HelmRelease would get, and fail if Helm rejects them.
#
# The values are assembled the way helm-controller does it: every `valuesFrom` entry in
# order, then `spec.values`. Helm merges the files the same way Flux merges the entries
# (maps are merged, lists and scalars are replaced). Helm checks the merged values against
# the chart's `values.schema.json` before it renders, so a misspelled or misplaced key
# fails here as it would fail on the cluster.
#
# Values that only exist at runtime are replaced by stubs from tools/values-stubs:
#   - cluster-values.yaml for the `<cluster>-cluster-values` ConfigMap, which is created
#     when the cluster is.
#   - cluster-app-installation-values.yaml for the `cluster-app-installation-values`
#     ConfigMap, which a Kyverno policy copies into every `org-*` namespace of a Giant
#     Swarm management cluster.
#   - charts/<chart>.yaml for values a chart can't render without the management cluster,
#     such as release-aws's switch to render without looking up its Release resource. They
#     are the first values file, so values from the repository take precedence. They don't
#     set the region, so that a cluster without one fails.
#
# The chart comes from the OCIRepository or HelmRepository in the manifest.
#
# The OCIRepositories and HelmReleases that a Flux Operator ResourceSet renders are checked
# too. Their tag comes from the ResourceSetInputProvider the ResourceSet reads, and which tag
# that picks is only known on the cluster, so an OCIRepository whose `spec.ref` is a template
# gets the provider's version range instead; a fixed tag stays. The check fails when it can't
# tell which provider's range that is, rather than guess. A rendered object that still has a
# `<< ... >>` template in it after that, such as one named after an entry of `spec.inputs`, is
# left out. It also fails for a ResourceSet without a namespace, or one that renders with
# `spec.resourcesTemplate`, as it can't render those.
#
# Every ConfigMap and Secret from `valuesFrom` that is in the manifest has to carry the
# label `reconcile.fluxcd.io/watch: Enabled`, so that helm-controller applies a change to it
# straight away instead of at the HelmRelease's next interval.
#
# The values of SOPS-encrypted Secrets are left out, since CI has no key to decrypt them.
#
# HelmReleases listed in validate-helm-values.ignore are rendered, but their errors don't
# fail the check.
#
# With --expand, it only prints the manifest with the objects the ResourceSets render added,
# for kubeconform to check them too.
#
# Usage: validate-helm-values [--expand] <manifest.yaml>
set -e -o pipefail

expand_only=0
if [ "$1" == "--expand" ]; then
	expand_only=1
	shift
fi
manifest="$1"
if [ -z "${manifest}" ] || [ ! -f "${manifest}" ]; then
	echo "Usage: $(basename "$0") [--expand] <manifest.yaml>" >&2
	exit 1
fi

stubs="$(dirname "$0")/values-stubs"
chart_cache="${TMPDIR:-/tmp}/gitops-template-charts"
kube_version="${KUBERNETES_VERSION:-1.36.5}"
ignore_file="$(dirname "$0")/validate-helm-values.ignore"
work_dir=$(mktemp -d)
trap 'rm -rf "${work_dir}"' EXIT

# Print the object of the given kind, namespace and name from the manifest.
function object() {
	KIND="$1" NS="$2" NAME="$3" yq -e 'select(.kind == strenv(KIND) and .metadata.namespace == strenv(NS) and .metadata.name == strenv(NAME))' "${manifest}" 2>/dev/null
}

# Print the objects each Flux Operator ResourceSet in the manifest renders, with the version
# range of its provider in place of an OCIRepository's templated tag. Objects with a template
# left in them are left out. Fail when a ResourceSet renders an OCIRepository whose range
# can't be found: its one `inputsFrom` entry has to name a provider in the manifest that has a
# `spec.filter.semver`. A guess, such as the newest chart, would validate the wrong values.
# Fail too for a ResourceSet without a namespace or with `spec.resourcesTemplate`, whose
# objects this can't render.
function resource_set_objects() {
	local ns name rset provider range objects templated errors=0
	while IFS=/ read -r ns name; do
		[ -z "${name}" ] && continue
		if [ -z "${ns}" ]; then
			echo "ResourceSet ${name}: no metadata.namespace, so the objects it renders can't be checked" >&2
			errors=1
			continue
		fi
		rset=$(object ResourceSet "${ns}" "${name}")
		if [ "$(yq '.spec.resourcesTemplate // "" | length' <<<"${rset}")" != "0" ]; then
			echo "ResourceSet ${ns}/${name}: spec.resourcesTemplate isn't supported, so the objects it renders can't be checked; use spec.resources" >&2
			errors=1
			continue
		fi
		range=""
		if [ "$(yq '.spec.inputsFrom // [] | length' <<<"${rset}")" == "1" ]; then
			provider=$(yq '.spec.inputsFrom[0].name // ""' <<<"${rset}")
			if [ -n "${provider}" ] && rsip=$(object ResourceSetInputProvider "${ns}" "${provider}"); then
				range=$(yq '.spec.filter.semver // ""' <<<"${rsip}")
			fi
		fi
		templated='.kind == "OCIRepository" and (.spec.ref // {} | to_yaml | test("<<"))'
		if [ -z "${range}" ] && [ "$(yq "[.spec.resources[] | select(${templated})] | length" <<<"${rset}")" != "0" ]; then
			echo "ResourceSet ${ns}/${name}: can't resolve the chart version of its OCIRepository: it needs one inputsFrom entry that names a ResourceSetInputProvider in the same Kustomization, with a spec.filter.semver" >&2
			errors=1
			continue
		fi
		objects=$(NS="${ns}" RANGE="${range}" yq "(.spec.resources[] | select(${templated}) | .spec.ref) = {\"semver\": strenv(RANGE)} | .spec.resources[] | select(to_yaml | test(\"<<\") | not) | .metadata.namespace = (.metadata.namespace // strenv(NS)) | split_doc" <<<"${rset}")
		echo "---"
		echo "${objects}"
	done < <(yq -N 'select(.kind == "ResourceSet") | (.metadata.namespace // "") + "/" + .metadata.name' "${manifest}")
	return "${errors}"
}

# Succeed if the HelmRelease (namespace/name) is listed in the ignore file.
function ignored() {
	[ -f "${ignore_file}" ] && sed 's/#.*//' "${ignore_file}" | tr -d '[:blank:]' | grep -qxF "$1"
}

# Fail unless the valuesFrom object (YAML) has the reconcile.fluxcd.io/watch: Enabled label, so
# helm-controller reconciles its HelmRelease when it changes. Uses the loop's id, kind, ns and
# ref_name.
function check_watch_label() {
	if [ "$(yq '.metadata.labels["reconcile.fluxcd.io/watch"] // ""' <<<"$1")" != "Enabled" ]; then
		echo "${id}: ${kind} ${ns}/${ref_name} from valuesFrom has no label reconcile.fluxcd.io/watch: Enabled"
		failed=1
	fi
}

# Pull a chart once and print the path of the archive.
# Arguments: chart reference (oci://... or a chart name), version or "", repository URL or "".
function pull_chart() {
	local ref="$1" version="$2" repo="$3"
	local dir
	dir="${chart_cache}/$(echo "${ref}|${version}|${repo}" | sha256sum | cut -c1-16)"
	if ! ls "${dir}"/*.tgz >/dev/null 2>&1; then
		mkdir -p "${dir}"
		local args=(pull "${ref}" -d "${dir}")
		[ -n "${version}" ] && args+=(--version "${version}")
		[ -n "${repo}" ] && args+=(--repo "${repo}")
		helm "${args[@]}" >/dev/null 2>"${dir}/pull.log" || {
			cat "${dir}/pull.log" >&2
			rm -rf "${dir}"
			return 1
		}
	fi
	ls "${dir}"/*.tgz
}

# Check what the ResourceSets render as if it were in the manifest itself.
expanded="${work_dir}/manifest.yaml"
cat "${manifest}" >"${expanded}"
echo >>"${expanded}"
if ! resource_set_objects >>"${expanded}"; then
	exit 1
fi
manifest="${expanded}"
if [ "${expand_only}" -eq 1 ]; then
	cat "${manifest}"
	exit 0
fi

failed=0
count=0

while IFS=/ read -r ns name; do
	[ -z "${name}" ] && continue
	count=$((count + 1))
	id="HelmRelease ${ns}/${name}"
	hr="${work_dir}/hr.yaml"
	object HelmRelease "${ns}" "${name}" >"${hr}"

	# Find the chart.
	ref="" version="" repo=""
	if [ "$(yq '.spec.chartRef.kind // ""' "${hr}")" == "OCIRepository" ]; then
		src_ns=$(yq ".spec.chartRef.namespace // \"${ns}\"" "${hr}")
		src_name=$(yq '.spec.chartRef.name' "${hr}")
		if ! src=$(object OCIRepository "${src_ns}" "${src_name}"); then
			echo "${id}: OCIRepository ${src_ns}/${src_name} is not in the same Kustomization"
			failed=1
			continue
		fi
		ref=$(yq '.spec.url' <<<"${src}")
		version=$(yq '.spec.ref.tag // .spec.ref.semver // ""' <<<"${src}")
	elif [ "$(yq '.spec.chart.spec.sourceRef.kind // ""' "${hr}")" == "HelmRepository" ]; then
		src_ns=$(yq ".spec.chart.spec.sourceRef.namespace // \"${ns}\"" "${hr}")
		src_name=$(yq '.spec.chart.spec.sourceRef.name' "${hr}")
		if ! src=$(object HelmRepository "${src_ns}" "${src_name}"); then
			echo "${id}: HelmRepository ${src_ns}/${src_name} is not in the same Kustomization"
			failed=1
			continue
		fi
		chart=$(yq '.spec.chart.spec.chart' "${hr}")
		version=$(yq '.spec.chart.spec.version // ""' "${hr}")
		if [ "$(yq '.spec.type // ""' <<<"${src}")" == "oci" ]; then
			ref="$(yq '.spec.url' <<<"${src}")/${chart}"
		else
			ref="${chart}"
			repo=$(yq '.spec.url' <<<"${src}")
		fi
	else
		echo "${id}: unsupported chart source, only OCIRepository and HelmRepository are supported"
		failed=1
		continue
	fi
	[ "${version}" == "*" ] && version=""

	if ! archive=$(pull_chart "${ref}" "${version}" "${repo}"); then
		echo "${id}: cannot pull chart ${ref} ${version}"
		failed=1
		continue
	fi
	chart_name=$(basename "${ref}")

	# Assemble the values files in the order helm-controller merges them.
	files=()
	notes=()
	if [ -f "${stubs}/charts/${chart_name}.yaml" ]; then
		files+=("${stubs}/charts/${chart_name}.yaml")
	fi

	entries=$(yq '.spec.valuesFrom // [] | length' "${hr}")
	for ((i = 0; i < entries; i++)); do
		entry=$(yq ".spec.valuesFrom[${i}]" "${hr}")
		kind=$(yq '.kind' <<<"${entry}")
		ref_name=$(yq '.name' <<<"${entry}")
		key=$(yq '.valuesKey // "values.yaml"' <<<"${entry}")
		optional=$(yq '.optional // false' <<<"${entry}")
		file="${work_dir}/values-${i}.yaml"

		if [ "$(yq '.targetPath // ""' <<<"${entry}")" != "" ]; then
			# its values aren't merged, but helm-controller still watches the object
			if obj=$(object "${kind}" "${ns}" "${ref_name}"); then
				check_watch_label "${obj}"
			fi
			notes+=("${kind} ${ref_name}: targetPath is not supported, left out")
			continue
		fi

		if ! obj=$(object "${kind}" "${ns}" "${ref_name}"); then
			if [[ "${kind}" == "ConfigMap" && "${ref_name}" == *-cluster-values ]]; then
				files+=("${stubs}/cluster-values.yaml")
			elif [[ "${kind}" == "ConfigMap" && "${ref_name}" == cluster-app-installation-values ]]; then
				files+=("${stubs}/cluster-app-installation-values.yaml")
			elif [ "${optional}" == "true" ]; then
				:
			else
				echo "${id}: ${kind} ${ns}/${ref_name} from valuesFrom is not in the rendered manifests"
				failed=1
			fi
			continue
		fi

		check_watch_label "${obj}"

		if [ "${kind}" == "Secret" ] && [ "$(yq '.sops // "" | length' <<<"${obj}")" != "0" ]; then
			notes+=("Secret ${ref_name}: SOPS-encrypted, left out")
			continue
		fi

		if [ "${kind}" == "Secret" ]; then
			KEY="${key}" yq '.stringData[strenv(KEY)] // (.data[strenv(KEY)] // "" | @base64d)' <<<"${obj}" >"${file}"
			# `flux build` replaces the data of SOPS-encrypted Secrets with this marker.
			if [ "$(cat "${file}")" == "**SOPS**" ]; then
				notes+=("Secret ${ref_name}: SOPS-encrypted, left out")
				continue
			fi
		else
			KEY="${key}" yq '.data[strenv(KEY)] // ""' <<<"${obj}" >"${file}"
		fi
		if [ ! -s "${file}" ] || [ "$(cat "${file}")" == "" ]; then
			if [ "${optional}" != "true" ] && ! KEY="${key}" yq -e '(.data // {}) + (.stringData // {}) | has(strenv(KEY))' <<<"${obj}" >/dev/null; then
				echo "${id}: ${kind} ${ns}/${ref_name} has no key ${key}"
				failed=1
			fi
			continue
		fi
		files+=("${file}")
	done

	if [ "$(yq '.spec.values // {} | length' "${hr}")" != "0" ]; then
		yq '.spec.values' "${hr}" >"${work_dir}/values-inline.yaml"
		files+=("${work_dir}/values-inline.yaml")
	fi

	args=(template "$(yq ".spec.releaseName // \"${name}\"" "${hr}")" "${archive}"
	--namespace "$(yq ".spec.targetNamespace // \"${ns}\"" "${hr}")"
	--kube-version "${kube_version}")
	for f in "${files[@]}"; do
		args+=(-f "${f}")
	done

	label="${id} (${chart_name} $(basename "${archive}" .tgz | sed "s/^${chart_name}-//"))"
	if ! helm "${args[@]}" >/dev/null 2>"${work_dir}/helm.log"; then
		if ignored "${ns}/${name}"; then
			echo "${label}: known failure, listed in $(basename "${ignore_file}"):"
		else
			echo "${label}:"
			failed=1
		fi
		sed 's/^/  /' "${work_dir}/helm.log"
	elif ignored "${ns}/${name}"; then
		echo "${label}: renders now, remove it from $(basename "${ignore_file}")"
		failed=1
	fi
	for n in "${notes[@]}"; do
		echo "${id}: ${n}"
	done
done < <(yq -N 'select(.kind == "HelmRelease") | .metadata.namespace + "/" + .metadata.name' "${manifest}")

if [ "${failed}" -ne 0 ]; then
	exit 1
fi
echo "${count} HelmRelease(s) rendered"
