#!/bin/bash
# shellcheck disable=SC2086,2207
#
# This script can be used to simulate the build capability of flux, print the generated manifests and
# optionally filter those manifests to ensure the generated resources are what is expected to be delivered
# to the cluster.
#
# As part of the build, it will extract any substitutions found in `spec.postBuild` and apply these to the
# parsed manifests using envsubst. With `flux build`, the default, a variable that the manifests use
# without a default value and that `spec.postBuild.substitute` doesn't set fails the build
# (`--strict-substitute`) instead of becoming an empty string.
#
# All manifests are then provided to `yq` for optional filtering.
set -e -o pipefail
shopt -s extglob
KUSTOMIZATIONS=()

##
# Print how to use this script
function usage() {
	if [ ${#KUSTOMIZATIONS[@]} -eq 0 ]; then
		KUSTOMIZATIONS+=(
			"./management-clusters/example/organizations/dev/workload-clusters/dev.yaml,dev,default,./management-clusters/example/organizations/dev/workload-clusters/dev"
		)
	fi
	cat <<EOF
Usage:
    - $(basename $0) list | list available kustomizations
    - $(basename $0) build <kustomization> [path] [--use-kustomize] [yqflags] [query]

---
If kustomization is a number, selects that kustomization from a list of all kustomizations
found in the repository.

If kustomization is a name, tries to find a kustomization matching that name.

To specify a namespace for the kustomization, use name:namespace (see examples)

For a list of valid names and numbers, use '$(basename $0) list'

Argument order is important. The script will fail if the arguments are not given in the
order specified above.

Optional Arguments
    path:   The path element is a subpath matching below the path defined in the kustomization you are parsing.
            For example, if the kustomization 'spec.path' is '$(cut -d, -f4 <<<${KUSTOMIZATIONS[0]})'
            then 'path' must be a relative path below this, e.g. 'apps/athena'

    --use-kustomize: Use kustomize to build the kustomization and not 'flux build'

    yqflags: Optional flags to pass to 'yq'. Use -M to turn off output coloring.

    query: This must be a valid 'yq' query and can be used to filter for specific resources.
           output coloring can be turned off using -M before the query

Examples:
  - Build all resources for kustomization by numeric index
    $(basename $0) build 1
  - Build all resources for kustomization by kustomization name
    $(basename $0) build prod-cluster
  - Build the kustomization "prod" in the "org-example" namespace
    $(basename $0) build prod:org-example
  - Build all by index but target the apps/athena subpath
    $(basename $0) build 1 apps/athena
  - Build all by name and select the athena HelmRelease, whose name ends in -athena
    $(basename $0) build prod-cluster 'select(.kind == "HelmRelease" and (.metadata.name | test("-athena$")))'
  - Build only the athena app and select its HelmRelease
    $(basename $0) build 1 apps/athena 'select(.kind == "HelmRelease")'
  - Build only the athena app and select its HelmRelease, turning off output colouring
    $(basename $0) build 1 apps/athena -M 'select(.kind == "HelmRelease")'
  - Build only the athena app and select its HelmRelease, turning off output colouring. Use kustomize for rendering, not flux
    $(basename $0) build 1 apps/athena --use-kustomize -M 'select(.kind == "HelmRelease")'
EOF
}

##
# We want to be running this script from git root to have widest possible discovery
[ "$(git rev-parse --show-toplevel 2>/dev/null)" != "$(pwd -P)" ] && echo "Not a valid git repository or not run from git root." && usage && exit 1

##
# Discover all fluxcd kustomizations and store filename, name, namespace, path, kind and source,
# `<kind>/<namespace>/<name>`, for each found
# $ns is a yq variable
# shellcheck disable=SC2016
export KUSTOMIZATIONS=(
	$(
		for f in $(find . -name '*.yaml' -not -path './tools/testdata/*' -exec awk '/api.*\.fluxcd\.io/{print FILENAME; nextfile}' {} \;); do
			yq --no-doc '(.metadata.namespace // "default") as $ns |
				[filename,.metadata.name,.metadata.namespace,.spec.path,.kind,
					.spec.sourceRef.kind + "/" + (.spec.sourceRef.namespace // $ns) + "/" + .spec.sourceRef.name] |
				select(.[4] == "Kustomization") | join(",")' $f
		done
	)
)

##
# find all resources for a given kustomization by traversing `path`
function _find_resources() {
	if ! [ -e "$1"/kustomization.yaml ]; then
		for f in $(find "$1" -maxdepth 1 -type f -name "*.yaml" | sed "s|$2/*||g"); do
			resources+=("$(tr -s '/' <<<$f)")
		done

		for d in $(find "$1" -maxdepth 1 -type d ! -path "$1"); do
			_find_resources "$d" "$2"
		done
	else
		r=$(echo "$1" | sed "s|$2/*||g")
		resources+=("$(tr -s '/' <<<$r)")
	fi
}

##
# finds the length of the longest element in a column inside KUSTOMIZATIONS list
function _longest {
	local position=$1
	local l=0
	local n=0
	for k in "${KUSTOMIZATIONS[@]}"; do
		n=$(cut -d, -f${position} <<<$k)
		if [ ${#n} -gt $l ]; then
			l=${#n}
		fi
	done
	echo $l
}

##
# Create spaces. Useful to pad a line
function _fill() {
	FILL="${2:- }"
	for ((c = 0; c <= $1; c += ${#FILL})); do
		echo -n "${FILL:0:$1-$c}"
	done
}

##
# Lists all flux kustomizations and the path they will build
function list() {
	local n=0
	local spacer=5

	# Print the header row
	local header="  NAME"
	n=$((($(_longest 2) - 4) + spacer))
	header=${header}$(_fill $n)NAMESPACE

	n=$(($(_longest 3) - spacer))
	header=${header}$(_fill $n)PATH

	echo "${header}"

	local i=0

	local kustomizationsSize=${#KUSTOMIZATIONS[@]}
	local kustomizationsScale=${#kustomizationsSize}

	for k in "${KUSTOMIZATIONS[@]}"; do
		spacedSerial=$(printf "%-${kustomizationsScale}s" ${i})

		name=$(cut -d, -f2 <<<${k})
		na=$((($(_longest 2) - ${#name}) + spacer))

		namespace="$(cut -d, -f3 <<<$k)"
		ns=$(($(_longest 3) - ${#namespace}))
		path=$(_fill $n)$(cut -d, -f4 <<<$k)
		echo "$spacedSerial ${name}$(_fill ${na})${namespace}$(_fill ${ns})${path}"
		i=$((i + 1))
	done
}

##
# finds the kustomization the user wants to build in the array
function _find_kustomization() {
	local kustomization=""
	case $1 in
	"")
		echo "Please select a kustomization from the list" >&2
		list
		;;
	+([0-9]))
		kustomization=${KUSTOMIZATIONS[$1]}
		echo ${kustomization}
		;;
	*)
		local matches=()
		local name="$1"
		local namespace=""
		if grep -q ':' <<<${name}; then
			namespace=$(cut -d: -f2 <<<${name})
			name=$(cut -d: -f1 <<<${name})
		fi
		for k in "${KUSTOMIZATIONS[@]}"; do
			if [ "$(cut -d, -f2 <<<$k)" == "${name}" ]; then
				# the namespace its file names, or the one Flux applies it in. A build that fails
				# while finding that out stops here, with its error.
				if [ "${namespace}" == "" ] || [ "$(cut -d, -f3 <<<$k)" == "${namespace}" ]; then
					matches+=("$k")
				else
					applied_namespace=$(_applied_namespace "$k") || exit 1
					if [ "${applied_namespace}" == "${namespace}" ]; then
						matches+=("$k")
					fi
				fi
			fi
		done
		if [ ${#matches[@]} -eq 0 ]; then
			echo "No kustomization found. Valid kustomizations are:" >&2
			list
			exit 1
		elif [ ${#matches[@]} -gt 1 ]; then
			echo "Too many matches to build. Please select a kustomization to build" >&2
			list
			exit 1
		fi
		echo ${matches[0]}
		;;
	esac
}

# kustomize if it's installed, otherwise the one built into kubectl
if command -v kustomize >/dev/null; then
	kustomize_build=(kustomize build --load-restrictor=LoadRestrictionsNone)
else
	kustomize_build=(kubectl kustomize --load-restrictor=LoadRestrictionsNone)
fi

# The namespace an organisation's kustomization.yaml completes with the organisation's name
PLACEHOLDER_NAMESPACE="org-ORG_NAME"

##
# The directory a Flux Kustomization's `spec.path` names, as find prints it, from the repository
# root: `./a/b` for `a/b/`, `.` for `./` or none.
function _directory() {
	local path="${1#./}"
	path="${path%/}"
	echo "./${path}" | sed 's|^\./$|.|'
}

##
# The sources of this repository: the GitRepositories of the Kustomizations that apply the
# directory their own file is in, such as management-clusters/MC_NAME/MC_NAME.yaml, as in
# test-all-ff and check-kustomization-paths. One per line.
function _repository_sources() {
	local k file path source
	for k in "${KUSTOMIZATIONS[@]}"; do
		IFS=, read -r file _ _ path _ source <<<"${k}"
		if [ "$(dirname "${file}")" == "$(_directory "${path}")" ] && [[ "${source}" == GitRepository/* ]]; then
			echo "${source}"
		fi
	done | sort -u
}

##
# The Flux Kustomizations that may apply the file $1, other than the Kustomization $2 in it: the
# ones of this repository whose path holds the file, the deepest path first. One entry of
# KUSTOMIZATIONS per line.
function _parents() {
	local file="$1" name="$2" k k_file k_name path source sources dir
	sources=$(_repository_sources)
	for k in "${KUSTOMIZATIONS[@]}"; do
		IFS=, read -r k_file k_name _ path _ source <<<"${k}"
		[ "${k_file}" == "${file}" ] && [ "${k_name}" == "${name}" ] && continue
		grep -qxF -- "${source}" <<<"${sources}" || continue
		dir=$(_directory "${path}")
		if [ "${dir}" == "." ] || [[ "$(dirname "${file}")/" == "${dir}/"* ]]; then
			echo "${#dir} ${k}"
		fi
	done | sort -rn | cut -d' ' -f2-
}

##
# Select the Flux Kustomization named $name from the build on stdin: the one in the namespace
# $namespace, any namespace if it's empty. One in the namespace PLACEHOLDER_NAMESPACE matches one
# in any `org-` namespace of the build, as the replacement gives it the organisation's.
function _select_kustomization() {
	placeholder="${PLACEHOLDER_NAMESPACE}" yq '
		select(.apiVersion == "kustomize.toolkit.fluxcd.io/*" and .kind == "Kustomization" and
			.metadata.name == strenv(name) and
			(strenv(namespace) == "" or (.metadata.namespace // "default") == strenv(namespace) or
				(strenv(namespace) == strenv(placeholder) and ((.metadata.namespace // "") | test("^org-")))))'
}

##
# Write the Flux Kustomization named $2 in namespace $3, from file $1, to file $4 as Flux applies
# it, or fail if a build fails. $3 is the namespace its file names, empty if it names none, or the
# one Flux applies it in.
#
# A Kustomization that another Flux Kustomization of this repository applies is read from that
# parent's `flux build`, as the parent applies it: in the namespace of the parent's
# `targetNamespace`, with the values of the parent's `postBuild`. The parent is itself built as
# Flux applies it, so an organisation's namespace Kustomization brings the values its own
# parent's replacements set. The parent with the deepest path whose build has the Kustomization
# wins. $5 lists the Kustomizations being resolved already, so a Kustomization isn't its own
# parent's parent.
#
# Without such a parent, as for the management cluster's root Kustomization, the ancestor
# directories are built instead. Flux's generated build of a directory without a
# kustomization.yaml stops at a directory with one and builds it whole, so the file's directory
# is built by kustomize if it has one, and its parent too if that has one, and so on. A
# replacement in such an ancestor, such as the one in an organisation's kustomization.yaml that
# sets `organization`, changes the Kustomization. The highest of those directories whose build
# has the Kustomization wins; without one, the file is used as it is.
function _as_applied() {
	local file="$1" out="$4" seen="${5:-}" dir dirs=() parent p_file p_name p_namespace p_path p_applied
	seen="${seen} ${file}#$2"
	while read -r parent; do
		[ -n "${parent}" ] || continue
		IFS=, read -r p_file p_name p_namespace p_path _ <<<"${parent}"
		[[ "${seen} " == *" ${p_file}#${p_name} "* ]] && continue
		p_applied=$(mktemp)
		if ! _as_applied "${p_file}" "${p_name}" "${p_namespace}" "${p_applied}" "${seen}"; then
			rm -f "${p_applied}"
			return 1
		fi
		p_namespace=$(yq '.metadata.namespace // "default"' "${p_applied}")
		if ! flux build kustomization -n "${p_namespace}" "${p_name}" --path "${p_path}" \
			--kustomization-file "${p_applied}" --dry-run --strict-substitute |
			name="$2" namespace="$3" _select_kustomization >"${out}"; then
			rm -f "${p_applied}"
			return 1
		fi
		rm -f "${p_applied}"
		[ -s "${out}" ] && return 0
	done <<<"$(_parents "${file}" "$2")"

	dir=$(dirname "${file}")
	while [ "${dir}" != "." ] && [ -e "${dir}/kustomization.yaml" ]; do
		dirs=("${dir}" "${dirs[@]}")
		dir=$(dirname "${dir}")
	done
	for dir in "${dirs[@]}"; do
		"${kustomize_build[@]}" "${dir}" | name="$2" namespace="$3" _select_kustomization >"${out}" ||
			return 1
		[ -s "${out}" ] && return 0
	done
	cp "${file}" "${out}"
}

##
# The namespace Flux applies the Kustomization $1, an entry of KUSTOMIZATIONS, in; fail if the
# build that tells fails.
function _applied_namespace() {
	local file name namespace applied
	IFS=, read -r file name namespace _ <<<"$1"
	applied=$(mktemp)
	if ! _as_applied "${file}" "${name}" "${namespace}" "${applied}"; then
		rm -f "${applied}"
		return 1
	fi
	yq '.metadata.namespace // "default"' "${applied}"
	rm -f "${applied}"
}

##
# Build the given kustomization and applies any optional filtering
# Drop the empty documents a build can end in, which yq would print as blank lines.
function drop_empty_documents() {
	yq 'select(. != null)'
}

function build() {
	local kustomization=""
	local use_kustomize=false
	path=""

	kustomization=$(_find_kustomization $1)

	name="$(cut -d, -f2 <<<${kustomization})"
	namespace="$(cut -d, -f3 <<<${kustomization})"
	path="$(cut -d, -f4 <<<${kustomization})"
	kustomization="$(cut -d, -f1 <<<${kustomization})"

	# the Kustomization as Flux applies it, and the kustomization.yaml --use-kustomize writes
	applied=$(mktemp)
	generated=""
	cleanup() {
		rm -f "${applied}" ${generated:+"${generated}"}
	}
	trap cleanup EXIT SIGINT
	_as_applied "${kustomization}" "${name}" "${namespace}" "${applied}"
	namespace=$(yq '.metadata.namespace // "default"' "${applied}")

	if [ -n "$2" ] && [ -e "$(realpath $path/$2)" ]; then
		path="${path}/$2"
		shift
	fi
	shift

	if [ "$1" == "--use-kustomize" ]; then
		use_kustomize=true
		shift
	fi

	local yqflags=""
	if [[ "$1" =~ ^-.* ]]; then
		yqflags=$1
		shift
	fi

	if ! $use_kustomize; then
		flux build kustomization -n ${namespace} ${name} --path ${path} --kustomization-file ${applied} --dry-run --strict-substitute | drop_empty_documents | yq $yqflags "$*"
		return $?
	fi

	# If we want to use kustomize to build instead of flux, the following does this.

	if ! [ -e "${path}/kustomization.yaml" ]; then
		declare -a resources=()
		_find_resources "${path}" "${path}"

		generated="${path}/kustomization.yaml"
		cat <<-EOF >"${generated}"
			apiVersion: kustomize.config.k8s.io/v1beta1
			kind: Kustomization
			buildMetadata: [originAnnotations]
			resources:
			$(for f in "${resources[@]}"; do echo "- $f"; done)
		EOF
	fi

	toexport=$(yq '.spec.postBuild.substitute | to_entries | .[] | [ .key, .value ] | join("=")' "${applied}")
	for v in $toexport; do
		export "${v?}"
	done
	kustomize build --load-restrictor=LoadRestrictionsNone $path | envsubst | drop_empty_documents | yq $yqflags "$*"
}

function=$1
shift

case $function in
"list")
	list
	;;
"build")
	build "$@"
	;;
*)
	usage
	;;
esac
