#!/bin/bash
# shellcheck disable=SC2086,2207
set -euo pipefail

function help() {
	echo -e "
Test syntax using fake-flux-build helper. Must be run from repo root dir (a dir that contains
'management-clusters' dir).

Usage: $0 [validate|template]

"
	exit 1
}

##
# We want to be running this script from git root to have widest possible discovery
if [ ! -d .git ]; then
	echo "Not a valid git repository or not run from git root."
	help
fi

# Schema sources for kubeconform. Every object must match one of them: an object
# whose schema is in none of them fails validation instead of being skipped.
#
# Kubernetes version of the Giant Swarm management clusters, which is where the
# rendered manifests are applied.
KUBERNETES_VERSION="1.36.5"
KUBERNETES_SCHEMA_REF="2bfaff3898a7a4fa4e4760da3d2656211c9b4c71"
KUBERNETES_SCHEMA_REPOSITORY="https://raw.githubusercontent.com/yannh/kubernetes-json-schema/${KUBERNETES_SCHEMA_REF}/v${KUBERNETES_VERSION}-standalone-strict"

# Flux version shipped by the flux-app release on the management clusters
# (flux-app 1.12.2). The schemas are the ones Flux publishes with each release.
FLUX_VERSION="2.7.5"
FLUX_CRD_SCHEMAS_SHA256="63ec8f87d7bbc05c7eb7b75e36540b2897a150cb50c7ee1f28e1e3016dff31a2"
FLUX_CRD_SCHEMAS_URL="https://github.com/fluxcd/flux2/releases/download/v${FLUX_VERSION}/crd-schemas.tar.gz"

# Giant Swarm CRDs, such as Organization.
GS_SCHEMA_REF="108ad92b6114d12bb84d20a3e9740bea5b2afbf0"
GS_SCHEMA_REPOSITORY="https://raw.githubusercontent.com/giantswarm/json-schema/${GS_SCHEMA_REF}/master"

SCHEMA_CACHE="${TMPDIR:-/tmp}/gitops-template-schemas"
FLUX_SCHEMA_DIR="${SCHEMA_CACHE}/flux-v${FLUX_VERSION}"

fakeflux="$(dirname $0)/fake-flux"

##
# Download and unpack the Flux CRD schemas once, checking the archive's checksum.
function fetch_flux_schemas() {
	[ -s "${FLUX_SCHEMA_DIR}/helmrelease-helm-v2.json" ] && return 0

	local archive
	archive=$(mktemp)
	echo "Downloading Flux ${FLUX_VERSION} CRD schemas" >&2
	curl -sSfL -o "${archive}" "${FLUX_CRD_SCHEMAS_URL}"
	if ! echo "${FLUX_CRD_SCHEMAS_SHA256}  ${archive}" | sha256sum -c --status; then
		echo "Checksum mismatch for ${FLUX_CRD_SCHEMAS_URL}" >&2
		rm -f "${archive}"
		exit 1
	fi
	mkdir -p "${FLUX_SCHEMA_DIR}"
	tar -xzf "${archive}" -C "${FLUX_SCHEMA_DIR}"
	rm -f "${archive}"
}

##
# Discover all fluxcd kustomizations and store filename, name, namespace and path for each found
export KUSTOMIZATIONS=(
	$(
		for f in $(find . -name '*.yaml' -exec awk '/api.*\.fluxcd\.io/{print FILENAME; nextfile}' {} \;); do
			yq --no-doc '[filename,.metadata.name,.metadata.namespace,.spec.path,.kind] | select(.[4] == "Kustomization") | join(",")' $f
		done
	)
)

function test() {
	local mode="$1"
	local has_validation_errors=0
	tmp_dir=$(mktemp -d)

	if [ "${mode}" == "validate" ]; then
		fetch_flux_schemas
		mkdir -p "${SCHEMA_CACHE}/http"
	fi

	for kustomization in "${KUSTOMIZATIONS[@]}"; do
		name=$(cut -d, -f2 <<<${kustomization})
		namespace=$(cut -d, -f3 <<<${kustomization})
		if [ "${mode}" == "validate" ]; then
			echo "Testing kustomization ${name} from namespace ${namespace}" >&2
			tmp_file="${tmp_dir}/manifest.yaml"
			${fakeflux} build ${name}:${namespace} -M >"${tmp_file}"

			echo -n "yamllint: "
			if ! (yamllint "$tmp_file"); then
				has_validation_errors=1
			else
				echo "OK"
			fi

			echo -n "kubeconform: "
			if ! (
				kubeconform -strict -summary -output text \
					-kubernetes-version "${KUBERNETES_VERSION}" \
					-schema-location "${KUBERNETES_SCHEMA_REPOSITORY}/{{ .ResourceKind }}{{ .KindSuffix }}.json" \
					-schema-location "${FLUX_SCHEMA_DIR}/{{ .ResourceKind }}{{ .KindSuffix }}.json" \
					-schema-location "${GS_SCHEMA_REPOSITORY}/{{ .ResourceKind }}{{ .KindSuffix }}.json" \
					-cache "${SCHEMA_CACHE}/http" \
					"$tmp_file"
			); then
				has_validation_errors=1
			else
				echo "OK"
			fi

			echo -n "helm values: "
			if ! "$(dirname $0)/validate-helm-values" "$tmp_file"; then
				has_validation_errors=1
			fi
			echo ""
		else
			echo "---"
			${fakeflux} build ${name}:${namespace} -M
		fi
	done

	if [[ ${has_validation_errors} -ne 0 ]]; then
		echo "There are validation errors, please check the above output!"
		exit 2
	fi
}

if [ $# -gt 1 ]; then
	help
fi

case "${1:-}" in
validate | template)
	test "$1"
	;;
*)
	help
	;;
esac
