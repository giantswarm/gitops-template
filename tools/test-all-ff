#!/bin/bash
# shellcheck disable=SC2086,2207
set -euo pipefail

function help() {
	echo -e "
Test syntax using fake-flux-build helper. Must be run from repo root dir (a dir that contains
'management-clusters' dir).

Usage: $0 [validate|template]

"
	exit 1
}

##
# We want to be running this script from git root to have widest possible discovery
if [ ! -d .git ]; then
	echo "Not a valid git repository or not run from git root."
	help
fi

# Schema sources for kubeconform. Every object must match one of them: an object
# whose schema is in none of them fails validation instead of being skipped.
#
# Kubernetes version of the Giant Swarm management clusters, which is where the
# rendered manifests are applied.
# renovate: datasource=github-releases depName=kubernetes/kubernetes extractVersion=^v(?<version>.+)$
KUBERNETES_VERSION="1.36.5"
KUBERNETES_SCHEMA_REF="2bfaff3898a7a4fa4e4760da3d2656211c9b4c71"
KUBERNETES_SCHEMA_REPOSITORY="https://raw.githubusercontent.com/yannh/kubernetes-json-schema/${KUBERNETES_SCHEMA_REF}/v${KUBERNETES_VERSION}-standalone-strict"

# Flux version shipped by the flux-app release on the management clusters
# (flux-app 1.12.2). The schemas are the ones Flux publishes with each release.
# renovate: datasource=github-releases depName=fluxcd/flux2 extractVersion=^v(?<version>.+)$
FLUX_VERSION="2.7.5"
FLUX_CRD_SCHEMAS_SHA256="63ec8f87d7bbc05c7eb7b75e36540b2897a150cb50c7ee1f28e1e3016dff31a2"
FLUX_CRD_SCHEMAS_URL="https://github.com/fluxcd/flux2/releases/download/v${FLUX_VERSION}/crd-schemas.tar.gz"

# Giant Swarm CRDs, such as Organization.
GS_SCHEMA_REF="108ad92b6114d12bb84d20a3e9740bea5b2afbf0"
GS_SCHEMA_REPOSITORY="https://raw.githubusercontent.com/giantswarm/json-schema/${GS_SCHEMA_REF}/master"

# Other CRDs, such as Kyverno's ClusterPolicy and External Secrets Operator's ExternalSecret, from the CRDs catalog.
CRDS_CATALOG_REF="784ec895547a36e548e6810b41f27baade3a0890"
CRDS_CATALOG_REPOSITORY="https://raw.githubusercontent.com/datreeio/CRDs-catalog/${CRDS_CATALOG_REF}"

SCHEMA_CACHE="${TMPDIR:-/tmp}/gitops-template-schemas"
FLUX_SCHEMA_DIR="${SCHEMA_CACHE}/flux-v${FLUX_VERSION}"

fakeflux="$(dirname $0)/fake-flux"

##
# Download and unpack the Flux CRD schemas once, checking the archive's checksum.
function fetch_flux_schemas() {
	[ -s "${FLUX_SCHEMA_DIR}/helmrelease-helm-v2.json" ] && return 0

	local archive
	archive=$(mktemp "${tmp_dir}/flux-crd-schemas.XXXXXX")
	echo "Downloading Flux ${FLUX_VERSION} CRD schemas" >&2
	curl -sSfL -o "${archive}" "${FLUX_CRD_SCHEMAS_URL}"
	if ! echo "${FLUX_CRD_SCHEMAS_SHA256}  ${archive}" | sha256sum -c --status; then
		echo "Checksum mismatch for ${FLUX_CRD_SCHEMAS_URL}" >&2
		rm -f "${archive}"
		exit 1
	fi
	mkdir -p "${FLUX_SCHEMA_DIR}"
	tar -xzf "${archive}" -C "${FLUX_SCHEMA_DIR}"
	rm -f "${archive}"
}

##
# Print the Flux Kustomizations below the current directory that apply this repository, one per
# line: filename, name, namespace and path. They're the ones whose source is this repository's
# GitRepository, the source of a Kustomization that applies the directory its file is in, such
# as management-clusters/MC_NAME/MC_NAME.yaml, as in check-kustomization-paths. Another source,
# such as an application team's own repository, has nothing to build here: say so on stderr.
# Fail if no Kustomization applies the repository.
function repository_kustomizations() {
	local all=(
		$(
			for f in $(find . -name '*.yaml' -not -path './tools/testdata/*' -not -path './tests/*' -exec awk '/api.*\.fluxcd\.io/{print FILENAME; nextfile}' {} \;); do
				# $ns is a yq variable
				# shellcheck disable=SC2016
				yq --no-doc '(.metadata.namespace // "default") as $ns |
					[filename,.metadata.name,.metadata.namespace,.spec.path,.kind,
						.spec.sourceRef.kind + "/" + (.spec.sourceRef.namespace // $ns) + "/" + .spec.sourceRef.name] |
					select(.[4] == "Kustomization") | join(",")' $f
			done
		)
	)
	local k file path source sources=" " found=0
	for k in "${all[@]}"; do
		IFS=, read -r file _ _ path _ source <<<"${k}"
		path="${path#./}"
		path="${path%/}"
		if [ "$(dirname "${file#./}")" == "${path:-.}" ] && [[ "${source}" == GitRepository/* ]]; then
			sources+="${source} "
		fi
	done
	for k in "${all[@]}"; do
		if [[ "${sources}" == *" ${k##*,} "* ]]; then
			echo "${k%,*,*}"
			found=1
		else
			echo "Skipping kustomization $(cut -d, -f2 <<<"${k}"): its source, ${k##*,}, isn't this repository" >&2
		fi
	done
	if [ "${found}" -eq 0 ]; then
		echo "No kustomization applies this repository" >&2
		return 1
	fi
}

kustomizations=$(repository_kustomizations) || exit 1
mapfile -t KUSTOMIZATIONS <<<"${kustomizations}"
export KUSTOMIZATIONS

##
# Check the manifests in the given files against the schema sources above.
function kubeconform_check() {
	kubeconform -strict -summary -output text \
		-kubernetes-version "${KUBERNETES_VERSION}" \
		-schema-location "${KUBERNETES_SCHEMA_REPOSITORY}/{{ .ResourceKind }}{{ .KindSuffix }}.json" \
		-schema-location "${FLUX_SCHEMA_DIR}/{{ .ResourceKind }}{{ .KindSuffix }}.json" \
		-schema-location "${GS_SCHEMA_REPOSITORY}/{{ .ResourceKind }}{{ .KindSuffix }}.json" \
		-schema-location "${CRDS_CATALOG_REPOSITORY}/{{ .Group }}/{{ .ResourceKind }}_{{ .ResourceAPIVersion }}.json" \
		-cache "${SCHEMA_CACHE}/http" \
		"$@"
}

function test() {
	local mode="$1"
	local has_validation_errors=0
	# Every temporary file goes into tmp_dir, which is removed when the script exits,
	# whether the checks pass or fail.
	tmp_dir=$(mktemp -d)
	trap 'rm -rf "${tmp_dir}"' EXIT

	if [ "${mode}" == "validate" ]; then
		fetch_flux_schemas
		mkdir -p "${SCHEMA_CACHE}/http"
	fi

	for kustomization in "${KUSTOMIZATIONS[@]}"; do
		name=$(cut -d, -f2 <<<${kustomization})
		namespace=$(cut -d, -f3 <<<${kustomization})
		if [ "${mode}" == "validate" ]; then
			echo "Testing kustomization ${name} from namespace ${namespace}" >&2
			tmp_file="${tmp_dir}/manifest.yaml"
			# A Kustomization that doesn't build, for example because it leaves a variable
			# unset, has nothing to check. Report it and go on to the next one. The error goes
			# to stdout, which is what CI posts to the pull request.
			echo -n "build ${name}:${namespace}: "
			if ! build_errors=$(${fakeflux} build ${name}:${namespace} -M 2>&1 >"${tmp_file}"); then
				echo "${build_errors}"
				echo ""
				has_validation_errors=1
				continue
			fi
			echo "OK"

			echo -n "yamllint: "
			if ! yamllint "$tmp_file"; then
				has_validation_errors=1
			else
				echo "OK"
			fi

			echo -n "kubeconform: "
			if ! kubeconform_check "$tmp_file"; then
				has_validation_errors=1
			else
				echo "OK"
			fi

			echo -n "helm values: "
			if ! "$(dirname $0)/validate-helm-values" "$tmp_file"; then
				has_validation_errors=1
			fi
			echo ""
		else
			echo "---"
			${fakeflux} build ${name}:${namespace} -M
		fi
	done

	if [ "${mode}" == "validate" ]; then
		# The secret stores in bases/secret_stores read cloud secret managers, which CI can't
		# reach, so no cluster of the repository uses them and no Kustomization above builds
		# them. Each base is built here and its manifests checked.
		local secret_store_bases
		secret_store_bases=$(find bases/secret_stores -name kustomization.yaml -printf '%h\n' | sort)
		if [ -z "${secret_store_bases}" ]; then
			echo "No secret store bases found in bases/secret_stores."
			has_validation_errors=1
		fi
		for base in ${secret_store_bases}; do
			echo -n "build ${base}: "
			tmp_file="${tmp_dir}/base.yaml"
			if ! build_errors=$(kubectl kustomize "${base}" 2>&1 >"${tmp_file}"); then
				echo "${build_errors}"
				echo ""
				has_validation_errors=1
				continue
			fi
			echo "OK"
			echo -n "kubeconform: "
			if ! kubeconform_check "${tmp_file}"; then
				has_validation_errors=1
			else
				echo "OK"
			fi
			echo ""
		done
	fi

	if [ "${mode}" == "validate" ]; then
		# validate-helm-values must fail for a release-aws cluster that has no region.
		echo -n "helm values, cluster without a region: "
		status=0
		output=$("$(dirname $0)/validate-helm-values" "$(dirname $0)/testdata/release-aws-without-region.yaml" 2>&1) || status=$?
		if [ "${status}" -ne 0 ] && grep -q "Unable to default the region" <<<"${output}"; then
			echo "OK, reported"
		else
			echo "not reported:"
			echo "${output}"
			has_validation_errors=1
		fi
	fi

	if [ "${mode}" == "validate" ]; then
		# validate-helm-values must render a HelmRelease that a ResourceSet renders, and fail
		# for one whose cluster has no region.
		echo -n "helm values, ResourceSet cluster without a region: "
		status=0
		output=$("$(dirname $0)/validate-helm-values" "$(dirname $0)/testdata/resource-set-cluster-without-region.yaml" 2>&1) || status=$?
		if [ "${status}" -ne 0 ] && grep -q "HelmRelease org-demo/rset-no-region.*" <<<"${output}" &&
			grep -q "Unable to default the region" <<<"${output}"; then
			echo "OK, reported"
		else
			echo "not reported:"
			echo "${output}"
			has_validation_errors=1
		fi
	fi

	if [ "${mode}" == "validate" ]; then
		# validate-helm-values must fail, not guess the newest chart, when it can't tell
		# which provider gives a ResourceSet's OCIRepository its version.
		echo -n "helm values, ResourceSet version not resolvable: "
		status=0
		output=$("$(dirname $0)/validate-helm-values" "$(dirname $0)/testdata/resource-set-unresolved-version.yaml" 2>&1) || status=$?
		if [ "${status}" -ne 0 ] && grep -q "ResourceSet org-demo/rset-selector: can't resolve the chart version" <<<"${output}"; then
			echo "OK, reported"
		else
			echo "not reported:"
			echo "${output}"
			has_validation_errors=1
		fi
	fi

	if [ "${mode}" == "validate" ]; then
		# validate-helm-values must fail for a valuesFrom ConfigMap without the watch label.
		echo -n "helm values, ConfigMap without the watch label: "
		status=0
		output=$("$(dirname $0)/validate-helm-values" "$(dirname $0)/testdata/values-without-watch-label.yaml" 2>&1) || status=$?
		if [ "${status}" -ne 0 ] && grep -q "has no label reconcile.fluxcd.io/watch: Enabled" <<<"${output}"; then
			echo "OK, reported"
		else
			echo "not reported:"
			echo "${output}"
			has_validation_errors=1
		fi
	fi

	if [ "${mode}" == "validate" ]; then
		# fake-flux must fail for a cluster whose Kustomization doesn't set a variable its
		# manifests use. It runs in a copy, as fake-flux only builds the Kustomizations it
		# finds below the current directory, and the ones in tools/testdata are left out.
		echo -n "fake-flux, cluster with an unset variable: "
		fixture_dir="${tmp_dir}/unset-variable"
		mkdir -p "${fixture_dir}/.git"
		cp -r "$(dirname $0)/testdata/unset-variable/." "${fixture_dir}"
		fakeflux_path=$(realpath "${fakeflux}")
		status=0
		output=$(cd "${fixture_dir}" && "${fakeflux_path}" build unset-variable:default -M 2>&1) || status=$?
		if [ "${status}" -ne 0 ] && grep -q 'variable not set (strict mode): "release"' <<<"${output}"; then
			echo "OK, reported"
		else
			echo "not reported:"
			echo "${output}"
			has_validation_errors=1
		fi

		# fake-flux must build a Kustomization as Flux applies it: with the values the replacements
		# in an ancestor directory's kustomization.yaml set, as an organisation's sets
		# `organization` and the organisation's namespace in its workload clusters'
		# Kustomizations. The fixture has two Kustomizations of the same name: fake-flux tells
		# them apart by namespace, the one Flux applies them in or the one their file names.
		fixture_dir="${tmp_dir}/ancestor-replacement"
		mkdir -p "${fixture_dir}/.git"
		cp -r "$(dirname $0)/testdata/ancestor-replacement/." "${fixture_dir}"
		for check in "default:name: ancestor-replacement$" \
			"org-from-the-ancestor:name: ancestor-replacement-direct$" \
			"org-ORG_NAME:name: ancestor-replacement-direct$"; do
			echo -n "fake-flux, values an ancestor's replacements set, ancestor-replacement:${check%%:*}: "
			status=0
			output=$(cd "${fixture_dir}" && "${fakeflux_path}" build "ancestor-replacement:${check%%:*}" -M 2>&1) || status=$?
			if [ "${status}" -eq 0 ] && grep -q "namespace: org-from-the-ancestor" <<<"${output}" &&
				grep -q "${check#*:}" <<<"${output}"; then
				echo "OK, set"
			else
				echo "not set:"
				echo "${output}"
				has_validation_errors=1
			fi
		done

		# The replacement only updates `organization`: a Kustomization in the ancestor's build
		# without one fails the build, naming the field. fake-flux shows that error, also when it
		# looks a Kustomization up by the namespace Flux applies it in, which builds the ancestor.
		yq -i 'del(.spec.postBuild.substitute.organization)' "${fixture_dir}/organization/clusters/cluster.yaml"
		echo -n "fake-flux, a failed ancestor's build, looking up ancestor-replacement:org-from-the-ancestor: "
		status=0
		output=$(cd "${fixture_dir}" && "${fakeflux_path}" build ancestor-replacement:org-from-the-ancestor -M 2>&1) || status=$?
		if [ "${status}" -ne 0 ] && grep -q 'unable to find field "spec.postBuild.substitute.organization"' <<<"${output}" &&
			! grep -q "No kustomization found" <<<"${output}"; then
			echo "OK, reported"
		else
			echo "not reported:"
			echo "${output}"
			has_validation_errors=1
		fi

		# Without the same-named Kustomization in direct.yaml, building ancestor-replacement:default
		# looks nothing up, so only its own build can report the missing field. Reading the file
		# as it is instead would fail on the unset variable.
		echo -n "fake-flux, a Kustomization without organization in an ancestor's build: "
		rm "${fixture_dir}/organization/clusters/direct.yaml"
		yq -i 'del(.resources[] | select(. == "direct.yaml"))' "${fixture_dir}/organization/clusters/kustomization.yaml"
		status=0
		output=$(cd "${fixture_dir}" && "${fakeflux_path}" build ancestor-replacement:default -M 2>&1) || status=$?
		if [ "${status}" -ne 0 ] && grep -q 'unable to find field "spec.postBuild.substitute.organization"' <<<"${output}" &&
			! grep -q "var substitution failed" <<<"${output}"; then
			echo "OK, reported"
		else
			echo "not reported:"
			echo "${output}"
			has_validation_errors=1
		fi
	fi

	if [ "${mode}" == "validate" ]; then
		# test-all-ff must leave out a Kustomization whose source is another repository, such as
		# an application team's, even if its path exists here. It runs in a copy, as it only
		# builds the Kustomizations it finds below the current directory.
		echo -n "test-all-ff, a team's Kustomization: "
		fixture_dir="${tmp_dir}/team-source"
		mkdir -p "${fixture_dir}/.git"
		cp -r "$(dirname $0)/testdata/team-source/." "${fixture_dir}"
		script_path=$(realpath "$0")
		status=0
		output=$(cd "${fixture_dir}" && "${script_path}" template 2>&1) || status=$?
		if [ "${status}" -eq 0 ] && grep -q "Skipping kustomization team:" <<<"${output}"; then
			echo "OK, left out"
		else
			echo "built:"
			echo "${output}"
			has_validation_errors=1
		fi

		# It must build, and fail on, a Kustomization of this repository whose path is mistyped.
		echo -n "test-all-ff, a mistyped path: "
		fixture_dir="${tmp_dir}/mistyped-path"
		mkdir -p "${fixture_dir}/.git"
		cp -r "$(dirname $0)/testdata/mistyped-path/." "${fixture_dir}"
		status=0
		output=$(cd "${fixture_dir}" && "${script_path}" template 2>&1) || status=$?
		if [ "${status}" -ne 0 ] && ! grep -q "Skipping kustomization mistyped-path" <<<"${output}"; then
			echo "OK, reported"
		else
			echo "not reported:"
			echo "${output}"
			has_validation_errors=1
		fi
	fi

	if [ "${mode}" == "validate" ]; then
		# check-kustomization-paths must fail for a Kustomization whose path is gone, and for
		# one whose kustomization.yaml lists a directory that's gone.
		echo -n "check-kustomization-paths, gone paths: "
		status=0
		output=$("$(dirname $0)/check-kustomization-paths" "$(dirname $0)/testdata/gone-path" 2>&1) || status=$?
		if [ "${status}" -ne 0 ] && grep -q "default/gone-path in cluster.yaml: spec.path 'mapi/apps' doesn't exist" <<<"${output}" &&
			grep -q "default/lists-a-gone-directory in cluster.yaml: spec.path 'mapi' doesn't build" <<<"${output}" &&
			! grep -q "other-source" <<<"${output}"; then
			echo "OK, reported"
		else
			echo "not reported:"
			echo "${output}"
			has_validation_errors=1
		fi

		# It must take the repository's GitRepository from a Kustomization that applies the
		# repository root, `./`.
		echo -n "check-kustomization-paths, root Kustomization at ./: "
		status=0
		output=$("$(dirname $0)/check-kustomization-paths" "$(dirname $0)/testdata/root-path" 2>&1) || status=$?
		if [ "${status}" -ne 0 ] && grep -q "default/gone-path in root.yaml: spec.path 'mapi' doesn't exist" <<<"${output}"; then
			echo "OK, reported"
		else
			echo "not reported:"
			echo "${output}"
			has_validation_errors=1
		fi

		# It must fail, not pass, when it finds nothing to check.
		echo -n "check-kustomization-paths, no Kustomization: "
		mkdir -p "${tmp_dir}/no-kustomization"
		status=0
		output=$("$(dirname $0)/check-kustomization-paths" "${tmp_dir}/no-kustomization" 2>&1) || status=$?
		if [ "${status}" -ne 0 ] && grep -q "No Flux Kustomization found" <<<"${output}"; then
			echo "OK, reported"
		else
			echo "not reported:"
			echo "${output}"
			has_validation_errors=1
		fi
	fi

	if [[ ${has_validation_errors} -ne 0 ]]; then
		echo "There are validation errors, please check the above output!"
		exit 2
	fi
}

if [ $# -gt 1 ]; then
	help
fi

case "${1:-}" in
validate | template)
	test "$1"
	;;
*)
	help
	;;
esac
