#!/bin/bash
set -euo pipefail

function help() {
	echo -e "
Check that every directory a customer reads, copies or edits explains itself with a README.
Must be run from the repository root, or from the directory given as the only argument.

Usage: $0 [dir]

It walks bases/ and management-clusters/, so tests/, tools/, .github/ and docs/ are left out.
Every directory there needs a README.md (or readme.md), unless it's listed in COVERED below:
a leaf that's a copy of its siblings' shape, such as a stage or a region, which the README of
a parent directory covers. That README must name the leaf, as its path relative to the parent
followed by a slash, such as \`dev/\`.
"
	exit 1
}

# The leaves a parent README covers, one per line: the parent directory, then the leaf's path
#  relative to it.
COVERED=(
	"bases/apps hello-world"
	"bases/environments/regions eu_central"
	"bases/environments/regions eu_central/node_pool"
	"bases/environments/regions us_west"
	"bases/environments/regions us_west/node_pool"
	"bases/environments/stages dev"
	"bases/environments/stages staging"
	"bases/environments/stages prod"
	"bases/stacks/envoy-gateway gateway-api-crds"
	"bases/stacks/envoy-gateway envoy-gateway"
	"bases/stacks/envoy-gateway gateway-api-config"
)
ORG=management-clusters/MC_NAME/organizations/ORG_NAME
COVERED+=(
	"${ORG}/multicluster/apps hello-world-scheduled"
	"${ORG}/workload-clusters/WC_NAME cluster"
	"${ORG}/workload-clusters/WC_NAME apps"
	"${ORG}/workload-clusters/WC_NAME apps/cert-manager"
	"${ORG}/workload-clusters/WC_NAME_SCHEDULED_UPGRADES cluster"
	"${ORG}/workload-clusters/WC_NAME_OUT_OF_BAND_NO_FLUX_APP/teams hello-team"
)
# the out-of-band examples share their layout
for cluster in WC_NAME_OUT_OF_BAND_FLUX_APP WC_NAME_OUT_OF_BAND_NO_FLUX_APP; do
	for leaf in cluster cluster/apps apps apps/hello-world out-of-band out-of-band/configmaps; do
		COVERED+=("${ORG}/workload-clusters/${cluster} ${leaf}")
	done
done
# the stage and region examples: four clusters of one shape
for cluster in HELLO_APP_DEV_CLUSTER_1 HELLO_APP_STAGING_CLUSTER_1 HELLO_APP_PROD_CLUSTER_EU_CENTRAL \
	HELLO_APP_PROD_CLUSTER_US_WEST; do
	for leaf in cluster cluster/apps; do
		COVERED+=("${ORG}/workload-clusters/${cluster} ${leaf}")
	done
done

[ $# -gt 1 ] && help
cd "${1:-.}" || help

for top in bases management-clusters; do
	if [ ! -d "${top}" ]; then
		echo "No ${top}/ below $(pwd): nothing to check."
		exit 1
	fi
done

##
# The README of directory $1, if it has one.
function readme() {
	for name in README.md readme.md; do
		if [ -f "$1/${name}" ]; then
			echo "$1/${name}"
			return
		fi
	done
}

failed=0
declare -A covered
for entry in "${COVERED[@]}"; do
	read -r parent leaf <<<"${entry}"
	covered["${parent}/${leaf}"]=1
	if [ ! -d "${parent}/${leaf}" ]; then
		echo "${parent}/${leaf} is listed in COVERED in $0, but doesn't exist: remove it from the list."
		failed=1
		continue
	fi
	parent_readme=$(readme "${parent}")
	if [ -n "${parent_readme}" ] && ! grep -qF "${leaf}/" "${parent_readme}"; then
		echo "${parent_readme} covers ${parent}/${leaf}, but doesn't name it: describe \`${leaf}/\` there."
		failed=1
	fi
done

while IFS= read -r dir; do
	if [ -z "$(readme "${dir}")" ] && [ -z "${covered["${dir}"]:-}" ]; then
		echo "${dir} has no README.md: write one, or, if a parent's README covers it, list it in COVERED in $0."
		failed=1
	fi
done < <(find bases management-clusters -type d | sort)

exit ${failed}
