{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    // Base config - https://github.com/giantswarm/renovate-presets/blob/main/default.json5
    "github>giantswarm/renovate-presets:default.json5",
  ],
  // Opt-in manager, off by default in Renovate. `.pre-commit-config.yaml` is
  // this repository's only genuinely stale dependency surface: the
  // hand-authored workflows all track `giantswarm/github-workflows@main`, and
  // the `zz_generated.*` ones are devctl-managed and already in the preset's
  // `ignorePaths`.
  //
  // `tests/ats/Pipfile` is deliberately left managed here. Chart repos extend
  // `renovate-presets:tests-ats.json5` to disable it, because there the file is
  // owned by devctl and regenerated by align-files. This repository has no
  // generated CircleCI config (`gen.ci.generate` is unset in giantswarm/github),
  // so nothing regenerates it and the Pipfile is genuinely repo-owned.
  "pre-commit": {
    "enabled": true,
  },
  // OCIRepositories pin their chart in `spec.ref.tag` with a `repo:` comment
  // above it, the shape giantswarm/appcr-to-helmrelease-converter emits. The
  // preset's `repo:` patterns cover `version:` and friends but not `tag:`, and
  // Renovate's flux manager only scans gotk-components.yaml by default.
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^(bases|management-clusters)/.+\\.ya?ml$/"],
      "matchStrings": [
        "#\\s*repo: (?<depName>\\S+)\\n\\s*tag: \"?v?(?<currentValue>[^\"\\s]+)\"?",
      ],
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v?(?<version>.*)$",
    },
  ],
  "packageRules": [
    {
      // the Envoy Gateway charts are released as a compatible set (see the
      // gateway-api-bundle compatibility table), so move them together
      "groupName": "Envoy Gateway charts",
      "matchPackageNames": [
        "giantswarm/gateway-api-crds-app",
        "giantswarm/envoy-gateway-app",
        "giantswarm/gateway-api-config-app",
      ],
    },
  ],
}
