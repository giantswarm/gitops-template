{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    // Base config - https://github.com/giantswarm/renovate-presets/blob/main/default.json5
    "github>giantswarm/renovate-presets:default.json5",
  ],
  // The hand-authored workflows call `giantswarm/github-workflows` at a commit
  // SHA with a `# main` comment. The preset's github-actions manager updates
  // that digest to the head of `main` and automerges it ("Giant Swarm GitHub
  // workflows" group), so no rule is needed here. The preset's `pinDigests:
  // false` for `giantswarm/*` only stops Renovate from adding a SHA; it still
  // updates one that is there. The `zz_generated.*` workflows are
  // devctl-managed, still call `@main`, and are in the preset's `ignorePaths`.
  //
  // Opt-in manager, off by default in Renovate: `.pre-commit-config.yaml`.
  //
  // `tests/ats/Pipfile` is deliberately left managed here. Chart repos extend
  // `renovate-presets:tests-ats.json5` to disable it, because there the file is
  // owned by devctl and regenerated by align-files. This repository has no
  // generated CircleCI config (`gen.ci.generate` is unset in giantswarm/github),
  // so nothing regenerates it and the Pipfile is genuinely repo-owned.
  "pre-commit": {
    "enabled": true,
  },
  // Chart tags pinned in a Flux `OCIRepository`'s `spec.ref.tag`. Renovate's
  // flux manager reads them with the `docker` datasource, taking the `url`
  // without `oci://` as the dependency, but by default only in
  // `gotk-components.yaml`. The test assertions are included on purpose: they
  // repeat the tags, and Renovate puts every pin of one dependency in one PR.
  // The manager doesn't see a tag set by a kustomize patch, or one that is a
  // postBuild variable such as `${release}`; those pins need a `# renovate:`
  // comment for the regex manager below, with the same `depName`, or the PR
  // leaves them behind.
  "flux": {
    "managerFilePatterns": ["/\\.ya?ml$/"],
  },
  // Versions pinned in plain variables: the shared workflow's version inputs
  // in the hand-authored workflows, the constants in `tools/test-all-ff` and
  // `tests/ats/conftest.py`, the Giant Swarm release where the `release`
  // variable is set, and the chart tags kustomize patches set (the release in
  // each stage, hello-world in the app set and in prod). The release is the
  // tag of the `release-aws` chart, so these use the same dependency as the
  // flux manager finds in the manifests and test assertions, and one PR
  // updates them all. Each one has a comment on the line before it:
  //   # renovate: datasource=<datasource> depName=<name> [versioning=<v>] [registryUrl=<url>] [extractVersion=<regex>]
  // with the optional fields in that order, followed by `NAME: "x"`,
  // `NAME="x"` or `NAME = "x"`.
  "customManagers": [
    {
      "customType": "regex",
      "description": "Versions annotated with a `# renovate:` comment",
      "managerFilePatterns": [
        "/\\.ya?ml$/",
        "/^tools/test-all-ff$/",
        "/^tests/ats/conftest\\.py$/",
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?(?: registryUrl=(?<registryUrl>\\S+))?(?: extractVersion=(?<extractVersion>\\S+))?\\s*\\n\\s*[A-Za-z_][A-Za-z0-9_]*\\s*[:=]\\s*\"(?<currentValue>[^\"]+)\"",
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver-coerced{{/if}}",
    },
  ],
}
